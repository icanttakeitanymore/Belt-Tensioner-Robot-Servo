{
  "AutomaticReconnect": true,
  "SerialPortName": "COM8",
  "StartupDelayMs": 0,
  "IsConnecting": false,
  "IsEnabled": true,
  "LogIncomingData": false,
  "IsConnected": true,
  "BaudRate": 9600,
  "UpdateMessages": [
    {
      "Message": {
        "Interpreter": 1,
        "Expression": "var mt = $prop('Settings.max_test'), tm = ($prop('Settings.tmax') || 60) & 126;\nreturn String.fromCharCode(0, $prop('Settings.LeftOffset'), 1, $prop('Settings.RightOffset'), mt ? tm : 2, mt ? (tm + 1) : 3);"
      },
      "IsEnabled": true,
      "MaximumFrequency": 0
    },
    {
      "Message": {
        "Interpreter": 1,
        "Expression": "var run = $prop('DataCorePlugin.GameRunning'), speed = $prop('SpeedMph') || $prop('SpeedKmh') || 0;\nvar gLong = $prop('GlobalAccelerationG') || 0;\n\n// 1. Extract raw sustained forces (Noise Gated)\nvar lat = (run && speed > 1) ? $prop('AccelerationSway') * $prop('Settings.yaw_gain') : 0;\nvar dec = (run && speed > 1) ? Math.max(0, -gLong * $prop('Settings.decel_gain')) : 0;\n\n// 2. Vector distribution for weight transfer\nvar r = Math.sqrt(dec * dec + lat * lat), l = Math.max(0, (dec * 2) - r);\nif (lat < 0) { var tmp = r; r = l; l = tmp; }\n\n// 3. Low-pass IIR filter for smooth sustained sensations\nif (root[\"sl\"] == null || root[\"sr\"] == null) { root[\"sr\"] = r; root[\"sl\"] = l; }\nvar tc = Math.max(1.0, 1.0 + ($prop('Settings.smooth') || 0));\n\nvar diffR = r - root[\"sr\"]; root[\"sr\"] += Math.abs(diffR) < 0.05 ? diffR : (diffR / tc);\nvar diffL = l - root[\"sl\"]; root[\"sl\"] += Math.abs(diffL) < 0.05 ? diffL : (diffL / tc);\n\n// 4. High-pass filter for instant transients (Gear shifts / Clutch bites)\nvar active = (run && speed > 1);\nvar acc = active ? Math.max(0, gLong) : 0;\nvar lastAcc = root[\"lastAcc\"] || 0;\nvar wasActive = root[\"wasActive\"] || false;\n// Suppress kick on first active frame after idle \u2014 lastAcc is stale from a previous session\nvar kick = (active && wasActive && acc > lastAcc) ? (acc - lastAcc) * 30 : 0;\nroot[\"lastAcc\"] = acc;\nroot[\"wasActive\"] = active;\n\n// Reset persistent cache environments in UI calibration test modes\nif ($prop('Settings.max_test') || $prop('Settings.TestOffsets')) {\n    root[\"sl\"] = root[\"sr\"] = root[\"lastL\"] = root[\"lastR\"] = root[\"lastAcc\"] = root[\"wasActive\"] = null; return \"\";\n}\n\n// 5. Bypass injection: Add transient kick directly to filtered values\nvar finalL = root[\"sl\"] + kick;\nvar finalR = root[\"sr\"] + kick;\n\n// Boundaries mapping & dynamic bit-packing (Left even, Right odd)\nvar tmax = ($prop('Settings.tmax') || 60) & 126;\nl = Math.min(tmax, Math.max(2, finalL)) & 126;\nr = Math.min(tmax, Math.max(3, finalR)) | 1;\n\n// 6. Delta transmission guard to eliminate silent serial spam\nif (l === root[\"lastL\"] && r === root[\"lastR\"]) return \"\";\nroot[\"lastL\"] = l; root[\"lastR\"] = r;\n\nreturn String.fromCharCode(l, r);"
      },
      "IsEnabled": true,
      "MaximumFrequency": 0
    }
  ],
  "OnConnectMessage": {
    "Expression": "' !'"
  },
  "OnDisconnectMessage": {
    "Expression": "' !'"
  },
  "DtrEnable": true,
  "RtsEnable": true,
  "EditorExpanded": true,
  "Name": "Custom Serial device",
  "Description": "Belt tensioner",
  "IsFreezed": false,
  "SettingsBuilder": {
    "Settings": [
      {
        "Maximum": 70,
        "Minimum": 0,
        "PropertyName": "LeftOffset",
        "CurrentValue": 0,
        "TypeName": "SliderEntry",
        "IsEnabled": true,
        "IsVisible": true,
        "Label": "Left untensioned"
      },
      {
        "Maximum": 70,
        "Minimum": 0,
        "PropertyName": "RightOffset",
        "CurrentValue": 0,
        "TypeName": "SliderEntry",
        "IsEnabled": true,
        "IsVisible": true,
        "Label": "Right untensioned"
      },
      {
        "PropertyName": "TestOffsets",
        "CurrentValue": false,
        "TypeName": "BoolEntry",
        "IsEnabled": true,
        "IsVisible": true,
        "Label": "Test untensioned positions"
      },
      {
        "Maximum": 100,
        "Minimum": 0,
        "PropertyName": "decel_gain",
        "CurrentValue": 50,
        "TypeName": "SliderEntry",
        "IsEnabled": true,
        "IsVisible": true,
        "Label": "decel gain"
      },
      {
        "Maximum": 80,
        "Minimum": 0,
        "PropertyName": "yaw_gain",
        "CurrentValue": 8,
        "TypeName": "SliderEntry",
        "IsEnabled": true,
        "IsVisible": true,
        "Label": "delta yaw gain"
      },
      {
        "Maximum": 4,
        "Minimum": 0,
        "PropertyName": "smooth",
        "CurrentValue": 2,
        "TypeName": "SliderEntry",
        "IsEnabled": true,
        "IsVisible": true,
        "Label": "smoothing"
      },
      {
        "Maximum": 127,
        "Minimum": 20,
        "PropertyName": "tmax",
        "CurrentValue": 60,
        "TypeName": "SliderEntry",
        "IsEnabled": true,
        "IsVisible": true,
        "Label": "max tension"
      },
      {
        "PropertyName": "max_test",
        "CurrentValue": false,
        "TypeName": "BoolEntry",
        "IsEnabled": true,
        "IsVisible": true,
        "Label": "test max tension"
      }
    ],
    "IsEditMode": false
  }
}